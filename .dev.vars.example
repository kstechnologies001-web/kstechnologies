# Copy this file to .dev.vars for local Wrangler Pages development.
# Replace placeholders with test credentials. .dev.vars is ignored by Git.
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_TEST_SECRET_KEY
PAYSTACK_WEBHOOK_SECRET=YOUR_PAYSTACK_WEBHOOK_SIGNING_SECRET
# Optional; otherwise the function uses the local site origin for the callback.
PAYSTACK_CALLBACK_URL=http://localhost:8788/payment-success.html
